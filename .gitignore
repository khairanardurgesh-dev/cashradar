# ============================================
# CashRadar - Git Ignore
# ============================================

# Environment variables / secrets
.env
.env.*
!.env.example

# Python
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Python virtual environments
.venv/
venv/
env/
ENV/

# FastAPI / local files
*.log

# Node
node_modules/
.npm/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Next.js
frontend/.next/
frontend/out/

# Build output
dist/
build/

# OS files
.DS_Store
Thumbs.db
desktop.ini

# IDE
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# Local database / temporary files
*.sqlite
*.sqlite3
*.db

# Uploaded test files
uploads/